#!name=自动策略
#!desc=根据当前网络自动切换策略
#!author=Peng-YM
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/WiFi.png

[Argument]
wifi = input,"",tag=Wi-Fi名称,desc=多个Wi-Fi使用英文逗号分隔
silence = switch,false,tag=静默运行,desc=关闭后显示切换通知

[Script]
network-changed script-path=https://raw.githubusercontent.com/wuyuqq/247cp/refs/heads/master/loon/script/auto-policy1.2.js,argument=[{wifi},{silence}]

#!name = IPv6 地址变化检测
#!desc = 定时检测公网 IPv6，支持指定 SSID
#!author = qiushaoming
#!loon_version = 3.5.1(983)
#!tag = IPv6,网络,通知

[Argument]
enabled = switch,true,tag=启用检测

cron = input,"*/5 * * * *",tag=Cron定时任务,desc=例如：*/5 * * * *（每5分钟）

ssid = input,"",tag=指定SSID,desc=仅在指定Wi-Fi下检测，多个SSID用英文逗号分隔，留空不限制

[Script]
cron ${cron} then script("https://raw.githubusercontent.com/wuyuqq/247cp/refs/heads/master/loon/script/ipv6-check.js", {${enabled}, ${ssid}}) with enable=${enabled},tag="IPv6地址检测",timeout=30
